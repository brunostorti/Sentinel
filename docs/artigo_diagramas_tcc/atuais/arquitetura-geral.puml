@startuml
!include <C4/C4_Container>
LAYOUT_LEFT_RIGHT()
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName Arial

Person(employee, "Colaborador", "Responde pesquisas e utiliza canais de escuta.")
Person(manager, "Gestão da empresa", "ADMIN, HR e MANAGER; acesso conforme permissões.")
Person(master, "Administração da plataforma", "SUPER_ADMIN; gestão de empresas exige is_master.")
Person(verifier, "Verificador público", "Consulta autenticidade do certificado por hash.")

System_Boundary(sentinel, "Sentinel") {
  Container(web, "Interface web", "React 19 / TypeScript / navegador", "Pesquisas, ciclos e áreas de gestão. Exportação local de relatórios; rascunhos no navegador.")
  Container(backend, "Aplicação no servidor", "Next.js 16 / TypeScript", "Server Components, Server Actions e API Routes. Regras de negócio, acesso a dados, IA e documentos.")
  ContainerDb(db, "Banco de dados", "PostgreSQL / Supabase Data API / pgvector", "Dados organizacionais e de pesquisas, planos, evidências e conhecimento. Agregações SQL, RPC e políticas RLS.")
  Container(storage, "Arquivos privados", "Supabase Storage", "Documentos da base de conhecimento e anexos de denúncias.")
}

System_Ext(auth, "Supabase Auth", "Identidade, sessões, senha e links de acesso por e-mail.")
System_Ext(openai, "OpenAI API", "Modelos de linguagem configuráveis e embeddings fixos da plataforma.")
System_Ext(anthropic, "Anthropic API", "Alternativa configurável para modelos de linguagem.")
System_Ext(google, "Google AI API", "Alternativa configurável para modelos de linguagem.")
System_Ext(maua, "Mauá AI", "Modelo do assistente por seleção direta ou fallback, se configurado.")

Rel(employee, web, "Responde e acompanha", "Interface web")
Rel(manager, web, "Gerencia e analisa", "Interface web")
Rel(master, web, "Administra a plataforma", "Interface web")
Rel(verifier, web, "Verifica certificado", "Interface web")
Rel(web, backend, "Solicita páginas, ações e APIs; recebe dados e arquivos", "HTTP(S); SSE no chat")
Rel(web, storage, "Abre anexos de denúncias por URL temporária emitida pelo backend", "HTTPS / URL assinada")
Rel(backend, db, "Consulta e grava; executa RPC", "HTTPS / SDK Supabase")
Rel(backend, storage, "Armazena e recupera arquivos", "HTTPS / SDK Supabase")
Rel(backend, auth, "Autentica, valida sessões e solicita e-mails de acesso", "HTTPS / SDK Supabase")
Rel(backend, openai, "Gera texto conforme configuração; cria embeddings", "HTTPS / AI SDK")
Rel(backend, anthropic, "Gera texto, quando selecionado", "HTTPS / AI SDK")
Rel(backend, google, "Gera texto, quando selecionado", "HTTPS / AI SDK")
Rel(backend, maua, "Consulta modelo do chat, por seleção ou fallback", "HTTPS / adaptador próprio")
@enduml
