@startuml
skinparam dpi 110
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam conditionStyle InsideDiamond
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam activity {
  BackgroundColor #EFF6FF
  BorderColor #315D8A
  FontColor #172033
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #334155
  DiamondFontColor #172033
  StartColor #172033
  EndColor #172033
}
skinparam swimlane {
  BorderColor #94A3B8
  TitleBackgroundColor #E2E8F0
  TitleFontColor #172033
  TitleFontStyle bold
}

|gestao|Gestão (RH / Admin)
|sistema|Sentinel
|colaborador|Colaboradores
|gestao|
start
:Criar ciclo e configurar\na pesquisa base;
|sistema|
:Salvar ciclo e pesquisa\nem rascunho;
|gestao|
repeat
  :Revisar e ativar\na pesquisa;
  |sistema|
  :Verificar participantes, abrir coleta\ne solicitar envio dos links de acesso;
  |colaborador|
  :Acessar e responder ao questionário\n(participantes que aderirem);
  |sistema|
  :Validar respostas e registrar\nconteúdo e participação separadamente;
  |gestao|
  :Acompanhar adesão\ne encerrar a coleta;
  |sistema|
  :Encerrar pesquisa e disparar geração\nde planos por IA em segundo plano;
  |gestao|
  :Consultar dashboard, relatórios\ne situação da geração dos planos;
  if (Revisar planos?) then ([sim])
    :Revisar planos e decidir\npela aprovação ou rejeição;
    |sistema|
    :Registrar decisões e vincular\nplanos aprovados ao Kanban;
    |gestao|
    :Registrar acompanhamento\ndas ações no Kanban;
  else ([não])
  endif
  :Consultar evidências do ciclo\ne evolução entre medições disponíveis;
  if (Solicitar certificado?) then ([sim])
    |sistema|
    :Avaliar checklist do ciclo\ne determinar nível documental;
    if (Nível disponível?) then ([sim])
      :Gerar PDF com QR Code\ne registrar certificado\nno nível 1, 2 ou 3;
    else ([não])
      :Informar evidências\npendentes para emissão;
    endif
    |gestao|
  else ([não])
  endif
backward :Abrir nova reavaliação\nno mesmo ciclo;
repeat while (Reavaliar?) is ([sim]) not ([não])
:Concluir acompanhamento\nnesta ocasião;
stop
@enduml
