# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Survey Progress Encryption
SURVEY_PROGRESS_ENCRYPTION_KEY=your-32-byte-hex-key

# IA — chaves da PLATAFORMA (opcionais). Cada empresa pode cadastrar a própria
# chave na tela "Modelos de IA"; estas só são usadas por quem não cadastrou.
# No chat, sem chave do provedor escolhido, o Sentinel usa a IA da Mauá (abaixo);
# a geração de planos exige a chave do provedor escolhido (a Mauá é só para o chat).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# "false" desliga as chaves acima: cada empresa passa a precisar da própria chave
# (o custo da IA fica com o cliente). Padrão: liberado (fase de testes).
AI_ALLOW_PLATFORM_KEYS=true

# Email (if using Resend instead of Supabase built-in)
RESEND_API_KEY=your-resend-api-key

# IA da Mauá (Barô) — gere a chave em https://ia.maua.br, em "Chaves de API"
MAUA_AI_BASE_URL=https://ia.maua.br/api/v1
MAUA_AI_API_KEY=baro_sua-chave-gerada-em-ia.maua.br
MAUA_AI_MODEL=google/gemma-3-27b
